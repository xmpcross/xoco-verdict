---
import type { GetStaticPathsOptions, Page } from "astro";
import ArchiveLayout from "@/layouts/ArchiveLayout.astro";
import { loadLibrary } from "@/lib/articles";
import { featuredFirst, kindMeta, summarize, type Article, type ArticleSummary } from "@/lib/content";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const library = await loadLibrary();
  const summaries = featuredFirst(library.comparisons).map(summarize);
  return paginate(summaries, { pageSize: 12, props: { articles: library.articles } });
}

interface Props {
  page: Page<ArticleSummary>;
  articles: Article[];
}

const { page, articles } = Astro.props;
const meta = kindMeta.comparison;
---

<ArchiveLayout
  title={meta.plural}
  description={meta.blurb}
  documentTitle={page.currentPage > 1 ? `Comparisons — page ${page.currentPage}` : "Comparisons"}
  meta={`${page.total} published`}
  articles={articles}
  page={page}
  label="Comparisons pagination"
  emptyMessage="No comparisons published yet."
/>
