---
import Icon from "@/components/ui/Icon.astro";
import { categoryMeta, categoryStyle, type Category } from "@/config/categories";
import { categoryHref } from "@/lib/content";

/**
 * A category as a desk rather than as a tag: its own colour, the buying
 * question it answers, and how much work stands behind it. No photograph — a
 * stock image of "audio" tells a reader nothing that the gradient and a count
 * do not tell them faster.
 */
interface Props {
  category: Category;
  articleCount: number;
  class?: string;
}

const { category, articleCount, class: className = "", ...rest } = Astro.props;
const meta = categoryMeta[category];
---

<a
  class:list={["catcard cat-band", className]}
  href={categoryHref(category)}
  style={categoryStyle(category)}
  {...rest}
>
  <span class="catcard__title">{category}</span>
  <span class="txt-m catcard__question">{meta.question}</span>
  <span class="catcard__foot">
    <span class="txt-eyebrow catcard__count">
      {articleCount}
      {articleCount === 1 ? " article" : " articles"}
    </span>
    <span class="catcard__arrow" aria-hidden="true">
      <Icon name="arrow-right" size={16} />
    </span>
  </span>
</a>

<style>
  .catcard {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    height: 100%;
    min-height: 12rem;
    border-radius: var(--radius-block);
    padding: 1.5rem;
    color: var(--foreground);
  }

  @media (min-width: 48rem) {
    .catcard {
      min-height: 13.5rem;
      padding: 1.75rem;
    }
  }

  /* The category name set as a statement: the tile has no picture, so the word
     itself has to be the thing a reader sees from across the grid. */
  .catcard__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1;
    text-transform: uppercase;
  }

  .catcard__question {
    color: color-mix(in srgb, var(--foreground) 72%, transparent);
    text-wrap: pretty;
  }

  .catcard__foot {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .catcard__count {
    color: var(--foreground);
    font-weight: 700;
  }

  .catcard__arrow {
    display: grid;
    place-items: center;
    color: var(--foreground);
    transition: transform 0.25s var(--ease-out);
  }

  .catcard:hover .catcard__arrow {
    transform: translateX(0.35rem);
  }
</style>
