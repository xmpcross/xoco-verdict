---
/**
 * A row of measured figures, for the moment in an article where the argument
 * turns on numbers. Import it in an `.mdx` file:
 *
 *   <KeyNumbers items={[
 *     { value: "31.4", unit: "dB", label: "Isolation at 100 Hz" },
 *     { value: "38", unit: "h", label: "Battery, ANC on" },
 *   ]} />
 */
interface Props {
  items: { value: string; unit?: string; label: string; note?: string }[];
  class?: string;
}

const { items, class: className = "", ...rest } = Astro.props;
---

<dl class:list={["keynums", className]} {...rest}>
  {
    items.map((item) => (
      <div class="keynums__item">
        <dd class="keynums__value tabular">
          {item.value}
          {item.unit && <span class="keynums__unit">{item.unit}</span>}
        </dd>
        <dt class="txt-label txt-dim">{item.label}</dt>
        {item.note && <p class="txt-cap txt-dim keynums__note">{item.note}</p>}
      </div>
    ))
  }
</dl>

<style>
  /* Two rules and some space, rather than a grid of boxes. */
  .keynums {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 1.25rem 2rem;
    margin: 2rem 0;
    border-block: 1px solid var(--border);
    padding-block: 1.35rem;
  }

  .keynums__item {
    display: grid;
    align-content: start;
    gap: 0.2rem;
  }

  .keynums__value {
    order: 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .keynums__unit {
    margin-left: 0.15rem;
    color: var(--muted-foreground);
    font-size: var(--fs-m);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .keynums__item dt {
    order: 2;
  }

  .keynums__note {
    order: 3;
  }
</style>
