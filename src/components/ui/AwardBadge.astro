---
import { awardMeta, type AwardKey } from "@/config/scoring";

/**
 * An award, printed as a plain chip. No icon and no outline: on a page that
 * already carries a coloured score badge, a second decorated object competes
 * with it for the same job.
 */
interface Props {
  award: AwardKey;
  class?: string;
}

const { award, class: className = "", ...rest } = Astro.props;
const meta = awardMeta(award);
---

<span class:list={["chip chip--award", className]} {...rest}>{meta.label}</span>
