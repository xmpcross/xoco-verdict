---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
  /** Set on the heading so a section's `aria-labelledby` can point at it. */
  id?: string;
  headingLevel?: "h2" | "h3";
  class?: string;
}

const {
  title,
  href,
  linkLabel = "See all",
  id,
  headingLevel = "h2",
  class: className = "",
  ...rest
} = Astro.props;

const Heading = headingLevel;
---

<div class:list={["section-head", className]} {...rest}>
  <Heading id={id} class="txt-h2">{title}</Heading>
  {
    href && (
      <a class="section-link" href={href}>
        {linkLabel}
        <span class="section-link__arrow">
          <Icon name="arrow-right" size={14} />
        </span>
      </a>
    )
  }
</div>
