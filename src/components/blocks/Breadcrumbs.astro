---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
  class?: string;
}

const { crumbs, class: className = "", ...rest } = Astro.props;
---

<nav class:list={["crumbs", className]} aria-label="Breadcrumb" {...rest}>
  <ol class="crumbs__list">
    {
      crumbs.map((crumb, index) => (
        <li class="crumbs__item">
          {/* A crumb without an href is the page you are on; everything that
              has one stays a link, including the last. */}
          {crumb.href ? (
            <a class="underline-hover" href={crumb.href}>{crumb.label}</a>
          ) : (
            <span aria-current="page">{crumb.label}</span>
          )}
          {index < crumbs.length - 1 && <span class="crumbs__sep" aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  /* The trail is set as an eyebrow — the same capitals, track, and greys as the
     category label on a card, so the small type above a headline reads in one
     voice wherever it appears. */
  .crumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--n-500);
    font-family: var(--font-display);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--ls-eyebrow);
    line-height: 1.3;
    text-transform: uppercase;
  }

  .crumbs__item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  /* Where the trail ends is where the reader is: it takes the weight of a
     category label, whether or not it is still a link. */
  .crumbs__item:last-child > :first-child,
  .crumbs__item [aria-current="page"] {
    color: var(--n-700);
    font-weight: 700;
  }

  .crumbs__sep {
    font-weight: 400;
    opacity: 0.55;
  }
</style>
