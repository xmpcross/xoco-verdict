---
import { Image } from "astro:assets";
import Icon from "@/components/ui/Icon.astro";
import { primaryNavigation, siteConfig } from "@/config/site";
import { categories, categoryStyle } from "@/config/categories";
import { socialIconFor } from "@/lib/socials";
import {
  categoryHref,
  formatDate,
  inCategory,
  kindMeta,
  summarize,
  type Article,
} from "@/lib/content";

/**
 * The bar, the command palette, and the mobile menu.
 *
 * The palette is deliberately the second thing in the header rather than the
 * last: on a site with a product database, search is how most readers navigate,
 * so it gets a labelled control instead of a bare magnifier glyph.
 */
interface Props {
  /** Every published article, used to seed the palette's offline fallback. */
  articles: Article[];
  /**
   * Rides over the block below it, in white, until the reader scrolls — for a
   * page that opens on a full-height photograph. The block underneath has to
   * pull itself up by `--header-height`; see `.pull-under-header`.
   */
  overlay?: boolean;
}

const { articles, overlay = false } = Astro.props;
const currentPath = Astro.url.pathname;
const isCurrentPath = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

/*
 * A parent item's own `href` is only where it lands a reader who clicks it; the
 * item is current when the page belongs to one of its children. Reading the
 * parent's href instead is what marked "Categories" as the current page on the
 * guides archive, since both point at `/blog/`.
 */
const isCurrentItem = (item: { href: string; children?: { href: string }[] }) =>
  item.children
    ? item.children.some((child) => isCurrentPath(child.href))
    : isCurrentPath(item.href);

/*
 * The category panel. Each desk shows the cover of its most recent article, so
 * the menu is a picture of what the site is publishing rather than a list of
 * words — and no category artwork has to be sourced or kept up to date. A desk
 * with nothing published is left out.
 */
const megaCategories = categories
  .map((category) => {
    const published = inCategory(articles, category);
    const latest = published[0];
    return {
      category,
      href: categoryHref(category),
      count: published.length,
      cover: latest ? summarize(latest).cover : undefined,
    };
  })
  .filter((desk) => desk.count > 0);

/**
 * Seed results, inlined so the palette works on the first keystroke and on a
 * page that never reaches the network. The full index arrives from
 * `/search-index.json` and replaces this as soon as it lands.
 */
const fallback = articles.slice(0, 10).map((article) => {
  const summary = summarize(article);
  return {
    title: summary.title,
    excerpt: summary.excerpt,
    href: summary.href,
    kind: kindMeta[summary.kind].label,
    category: summary.category,
    score: summary.score ?? null,
    date: formatDate(summary.updatedDate ?? summary.date),
    tags: summary.tags,
    bylines: summary.bylines.map((byline) => byline.name),
  };
});
---

<header class:list={["site-header", overlay && "site-header--overlay"]}>
  <div class="container site-header__inner">
    <a href="/" class="wordmark" aria-label={`${siteConfig.name} home`}>
      <span class="wordmark__text">{siteConfig.name}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {
        primaryNavigation.map((item) =>
          item.mega && megaCategories.length > 0 ? (
            /* The panel is not nested inside the bar's container — it runs the
               full width of the viewport — so this link only reports its state
               and the script below does the opening. Clicking it still goes
               somewhere, which is what keeps the menu usable without script. */
            <a
              class="nav__item nav__item--mega"
              href={item.href}
              aria-current={isCurrentItem(item) ? "page" : undefined}
              aria-expanded="false"
              aria-controls="mega-categories"
              data-mega-toggle
            >
              {item.label}
              <Icon name="caret-down" size={13} class="nav__caret" />
            </a>
          ) : item.children ? (
            <div class="nav__parent">
              <a
                class="nav__item"
                href={item.href}
                aria-current={isCurrentItem(item) ? "page" : undefined}
              >
                {item.label}
                <Icon name="caret-down" size={13} />
              </a>
              <div class="nav__submenu">
                {item.children.map((child) => (
                  <a class="nav__sublink" href={child.href}>
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              class="nav__item"
              href={item.href}
              aria-current={isCurrentItem(item) ? "page" : undefined}
            >
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="header-actions">
      <a
        href="/search/"
        class="header-search"
        aria-label="Search reviews, guides, and products"
        aria-haspopup="dialog"
        aria-controls="site-search-dialog"
        data-search-toggle
      >
        <Icon name="search" size={18} />
      </a>
      <a href="/#newsletter" class="btn btn--sm header-subscribe">Subscribe</a>
      <button
        type="button"
        class="icon-btn header-menu"
        aria-controls="mobile-menu-panel"
        aria-expanded="false"
        data-mobile-menu-toggle
      >
        <Icon name="menu" size={18} />
        <span class="sr-only">Open navigation menu</span>
      </button>
    </div>
  </div>

  {
    megaCategories.length > 0 && (
      <div class="mega" id="mega-categories" data-mega>
        <div class="container mega__inner">
          <ul class="mega__grid">
            {megaCategories.map((desk) => (
              <li>
                <a class="mega__desk" href={desk.href}>
                  <span class="mega__media cat-band" style={categoryStyle(desk.category)}>
                    {desk.cover && (
                      <Image
                        src={desk.cover.src}
                        alt=""
                        width={360}
                        height={270}
                        fit="cover"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </span>
                  <span class="mega__name">{desk.category}</span>
                  <span class="txt-eyebrow mega__count">
                    {desk.count} {desk.count === 1 ? "article" : "articles"}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )
  }
</header>

<dialog
  id="site-search-dialog"
  class="search-dialog"
  aria-labelledby="site-search-title"
  aria-describedby="site-search-description"
  data-search-dialog
>
  <div class="search-command">
    <form action="/search/" method="get" role="search" aria-label="Site search" data-search-form>
      <div class="search-command-field">
        <Icon name="search" size={20} class="search-command-icon" />
        <div class="min-w-0 flex-1">
          <h2 id="site-search-title" class="sr-only">Search {siteConfig.name}</h2>
          <label class="sr-only" for="site-search-input">Search reviews, guides, and products</label>
          <input
            id="site-search-input"
            name="q"
            type="search"
            class="search-command-input"
            placeholder="Search reviews, guides, products…"
            autocomplete="off"
            enterkeyhint="search"
            data-search-input
          />
        </div>
        <button type="button" class="icon-btn" aria-label="Close search" data-search-close>
          <Icon name="close" size={18} />
        </button>
      </div>

      <div class="search-command-body">
        <p
          id="site-search-description"
          class="txt-label txt-dim search-command-summary"
          data-search-summary
          aria-live="polite"
        >
        </p>
        <div class="search-command-results" data-search-results></div>
      </div>

      <div class="search-command-footer" aria-hidden="true">
        <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
        <span><kbd>↵</kbd> Open</span>
        <span class="ml-auto hidden sm:inline">Enter searches everything</span>
      </div>
    </form>
  </div>
</dialog>

<div
  id="mobile-menu-panel"
  class="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  hidden
>
  <div class="container mobile-menu__bar">
    <a href="/" class="wordmark" aria-label={`${siteConfig.name} home`}>
      <span class="wordmark__text">{siteConfig.name}</span>
    </a>
    <button type="button" class="icon-btn" data-mobile-menu-close aria-label="Close navigation menu">
      <Icon name="close" size={18} />
    </button>
  </div>

  <nav class="container mobile-menu__nav" aria-label="Mobile">
    <ul class="mobile-nav">
      {
        primaryNavigation.map((item, index) =>
          item.children ? (
            <li>
              <button
                type="button"
                class="mobile-nav__item mobile-nav__toggle"
                aria-expanded="false"
                aria-controls={`mobile-submenu-${index}`}
                data-mobile-submenu-toggle
              >
                {item.label}
                <Icon name="caret-down" size={18} class="mobile-nav__chevron" />
              </button>
              <ul class="mobile-nav__submenu" id={`mobile-submenu-${index}`} hidden>
                {item.children.map((child) => (
                  <li>
                    <a
                      class="mobile-nav__sublink"
                      href={child.href}
                      aria-current={isCurrentPath(child.href) ? "page" : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                class="mobile-nav__item"
                href={item.href}
                aria-current={isCurrentPath(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
      <li>
        <a class="mobile-nav__item" href="/post/how-we-test/">How we test</a>
      </li>
      <li>
        <a class="mobile-nav__item" href="/about/">About</a>
      </li>
    </ul>
    <a class="btn btn--lg mobile-menu__cta" href="/#newsletter">Subscribe</a>
    <ul class="mobile-menu__socials">
      {
        siteConfig.socials.map((item) => (
          <li>
            <a
              href={item.href}
              class="icon-btn"
              aria-label={item.label}
              rel={item.href.startsWith("http") ? "noreferrer" : undefined}
            >
              <Icon name={socialIconFor(item.label)} size={18} />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script
  is:inline
  type="application/json"
  id="site-search-fallback"
  set:html={JSON.stringify(fallback)}
/>

<script is:inline>
  (() => {
    const searchDialog = document.querySelector("[data-search-dialog]");
    const searchToggle = document.querySelector("[data-search-toggle]");
    const searchClose = searchDialog?.querySelector("[data-search-close]");
    const searchInput = searchDialog?.querySelector("[data-search-input]");
    const searchResults = searchDialog?.querySelector("[data-search-results]");
    const searchSummary = searchDialog?.querySelector("[data-search-summary]");
    let siteSearchData = [];
    let siteSearchDataPromise;

    const siteSearchFallback = JSON.parse(
      document.getElementById("site-search-fallback")?.textContent || "[]",
    );

    const loadSearchData = async () => {
      if (siteSearchData.length > 0) return siteSearchData;

      siteSearchDataPromise ??= fetch("/search-index.json")
        .then((response) => {
          if (!response.ok) throw new Error("Search index unavailable");
          return response.json();
        })
        .then((items) => {
          siteSearchData = Array.isArray(items) ? items : siteSearchFallback;
          return siteSearchData;
        })
        .catch(() => {
          siteSearchData = siteSearchFallback;
          return siteSearchData;
        });

      return siteSearchDataPromise;
    };

    const escapeHtml = (value) =>
      String(value).replace(
        /[&<>"']/g,
        (character) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[character],
      );

    /*
     * Product names beat prose. A reader typing "meridian" wants the laptop,
     * not the explainer that mentions it in passing, so an exact start-of-title
     * match outranks everything and body text ranks last.
     */
    const rankSearchItem = (item, query) => {
      const title = (item.title || "").toLowerCase();
      const product = (item.product || "").toLowerCase();
      const brand = (item.brand || "").toLowerCase();
      const category = (item.category || "").toLowerCase();
      const tags = (item.tags || []).join(" ").toLowerCase();
      const supporting = [item.excerpt, ...(item.bylines || [])].join(" ").toLowerCase();

      if (title.startsWith(query) || product.startsWith(query)) return 0;
      if (title.includes(query) || product.includes(query)) return 1;
      if (brand.includes(query)) return 2;
      if (`${category} ${tags}`.includes(query)) return 3;
      if (supporting.includes(query)) return 4;
      return Number.POSITIVE_INFINITY;
    };

    const searchResultMarkup = (item) => `
      <a href="${escapeHtml(item.href)}" class="search-result">
        <span class="search-result-copy">
          <span class="search-result-title">${escapeHtml(item.title)}</span>
          <span class="search-result-meta">
            <span>${escapeHtml(item.kind)}</span>
            <span aria-hidden="true">·</span>
            <span>${escapeHtml(item.category)}</span>
            <span aria-hidden="true">·</span>
            <span>${escapeHtml(item.date)}</span>
          </span>
        </span>
        ${
          item.score === null || item.score === undefined
            ? ""
            : `<span class="search-result-score">${escapeHtml(Number(item.score).toFixed(1))}</span>`
        }
      </a>
    `;

    const renderSearchResults = async () => {
      if (!searchInput || !searchResults || !searchSummary) return;

      const rawQuery = searchInput.value.trim();
      const query = rawQuery.toLowerCase();

      if (!query) {
        searchSummary.textContent = "";
        searchResults.innerHTML = "";
        return;
      }

      const items = await loadSearchData();
      if (searchInput.value.trim().toLowerCase() !== query) return;

      const matches = items
        .map((item) => ({ item, rank: rankSearchItem(item, query) }))
        .filter(({ rank }) => Number.isFinite(rank))
        .sort((a, b) => a.rank - b.rank)
        .slice(0, 8)
        .map(({ item }) => item);

      searchSummary.textContent = `${matches.length} ${matches.length === 1 ? "result" : "results"} for “${rawQuery}”`;

      if (matches.length === 0) {
        searchResults.innerHTML = `
          <div class="search-empty">
            <span class="search-empty-icon" aria-hidden="true">?</span>
            <div>
              <p class="txt-sub">Nothing matched</p>
              <p class="txt-xs txt-dim">Try a product name, a brand, or a category.</p>
            </div>
          </div>
        `;
        return;
      }

      searchResults.innerHTML = matches.map(searchResultMarkup).join("");
    };

    const openSearch = () => {
      if (!searchDialog || !searchInput || typeof searchDialog.showModal !== "function") return;
      if (!searchDialog.open) searchDialog.showModal();
      document.documentElement.classList.add("has-open-search");
      void renderSearchResults();
      window.requestAnimationFrame(() => searchInput.focus());
    };

    const closeSearch = () => {
      if (searchDialog?.open) searchDialog.close();
    };

    searchToggle?.addEventListener("click", (event) => {
      if (!searchDialog || typeof searchDialog.showModal !== "function") return;
      event.preventDefault();
      openSearch();
    });

    searchClose?.addEventListener("click", closeSearch);

    searchDialog?.addEventListener("close", () => {
      document.documentElement.classList.remove("has-open-search");
      searchToggle?.focus();
    });

    searchDialog?.addEventListener("click", (event) => {
      if (event.target === searchDialog) closeSearch();
    });

    searchInput?.addEventListener("input", () => {
      void renderSearchResults();
    });

    searchInput?.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown") return;
      const firstResult = searchResults?.querySelector("a");
      if (!firstResult) return;
      event.preventDefault();
      firstResult.focus();
    });

    searchResults?.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;

      const links = Array.from(searchResults.querySelectorAll("a"));
      const currentIndex = links.indexOf(document.activeElement);
      if (currentIndex === -1) return;

      event.preventDefault();
      if (event.key === "ArrowDown") {
        (links[currentIndex + 1] || links[0])?.focus();
      } else if (currentIndex === 0) {
        searchInput?.focus();
      } else {
        links[currentIndex - 1]?.focus();
      }
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target;
      const isEditing =
        target instanceof HTMLElement &&
        (target.matches("input, textarea, select") || target.isContentEditable);
      const isCommandShortcut = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k";
      const isSlashShortcut =
        event.key === "/" && !isEditing && !event.metaKey && !event.ctrlKey && !event.altKey;

      if (!isCommandShortcut && !isSlashShortcut) return;
      event.preventDefault();

      if (searchDialog?.open && isCommandShortcut) closeSearch();
      else openSearch();
    });

    const siteHeader = document.querySelector(".site-header");

    if (siteHeader) {
      let scrollTicking = false;
      let lastScrollY = window.scrollY;

      const updateHeaderScrolled = () => {
        const currentScrollY = window.scrollY;

        siteHeader.classList.toggle("is-scrolled", currentScrollY > 8);

        if (currentScrollY <= 8) {
          siteHeader.classList.remove("is-hidden");
        } else if (currentScrollY > lastScrollY) {
          siteHeader.classList.add("is-hidden");
        } else if (currentScrollY < lastScrollY) {
          siteHeader.classList.remove("is-hidden");
        }

        lastScrollY = currentScrollY;
        scrollTicking = false;
      };

      updateHeaderScrolled();

      window.addEventListener(
        "scroll",
        () => {
          if (scrollTicking) return;
          scrollTicking = true;
          window.requestAnimationFrame(updateHeaderScrolled);
        },
        { passive: true },
      );

      /*
       * The category panel.
       *
       * Hover alone cannot hold a menu open reliably: the pointer has to leave
       * the item that opened it to reach anything inside, and every gap or
       * diagonal on that path is a chance to close. So the state lives in one
       * class on the bar, the panel opens the moment the pointer or the keyboard
       * arrives, and it closes on a short timer that anything re-entering
       * cancels — including the panel itself.
       */
      const megaToggle = siteHeader.querySelector("[data-mega-toggle]");
      const mega = siteHeader.querySelector("[data-mega]");

      if (megaToggle && mega) {
        let closeTimer;

        const setMega = (open) => {
          window.clearTimeout(closeTimer);
          siteHeader.classList.toggle("is-mega-open", open);
          megaToggle.setAttribute("aria-expanded", open ? "true" : "false");
        };

        const openMega = () => setMega(true);
        const closeMega = () => setMega(false);

        /* Long enough to cross the bar, short enough not to sit in the way. */
        const scheduleClose = () => {
          window.clearTimeout(closeTimer);
          closeTimer = window.setTimeout(closeMega, 260);
        };

        [megaToggle, mega].forEach((element) => {
          element.addEventListener("pointerenter", (event) => {
            /* A tap is a click on the link, not a hover. */
            if (event.pointerType === "touch") return;
            openMega();
          });
          element.addEventListener("pointerleave", (event) => {
            if (event.pointerType === "touch") return;
            scheduleClose();
          });
        });

        /*
         * A touch screen has no hover, and a tablet is wide enough to be
         * served the desktop bar: there the first tap opens the panel and the
         * second follows the link.
         */
        megaToggle.addEventListener("click", (event) => {
          if (event.pointerType !== "touch") return;
          if (siteHeader.classList.contains("is-mega-open")) return;
          event.preventDefault();
          openMega();
        });

        document.addEventListener("pointerdown", (event) => {
          if (event.pointerType !== "touch") return;
          if (!siteHeader.classList.contains("is-mega-open")) return;
          const target = event.target;
          if (target === megaToggle || megaToggle.contains(target) || mega.contains(target)) return;
          closeMega();
        });

        megaToggle.addEventListener("focus", openMega);

        /* Tabbing out of the pair closes it; tabbing between them does not. */
        document.addEventListener("focusin", (event) => {
          if (!siteHeader.classList.contains("is-mega-open")) return;
          const target = event.target;
          if (target === megaToggle || mega.contains(target)) return;
          closeMega();
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && siteHeader.classList.contains("is-mega-open")) {
            closeMega();
            megaToggle.focus();
          }
        });

        /* Scrolling is a decision to read the page, not the menu. */
        window.addEventListener("scroll", closeMega, { passive: true });
      }
    }

    const mobileMenuButton = document.querySelector("[data-mobile-menu-toggle]");
    const mobileMenuPanel = document.getElementById("mobile-menu-panel");

    if (mobileMenuButton && mobileMenuPanel) {
      const mobileMenuClose = mobileMenuPanel.querySelector("[data-mobile-menu-close]");
      const mobileMenuFirstLink = mobileMenuPanel.querySelector("a");
      const desktopMedia = window.matchMedia("(min-width: 64rem)");
      const focusableSelector =
        'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
      let inertedElements = [];

      const submenuToggles = Array.from(
        mobileMenuPanel.querySelectorAll("[data-mobile-submenu-toggle]"),
      );

      const setSubmenuOpen = (toggle, open) => {
        const submenu = document.getElementById(toggle.getAttribute("aria-controls"));
        if (!submenu) return;
        toggle.setAttribute("aria-expanded", String(open));
        submenu.hidden = !open;
      };

      submenuToggles.forEach((toggle) => {
        toggle.addEventListener("click", () => {
          setSubmenuOpen(toggle, toggle.getAttribute("aria-expanded") !== "true");
        });
      });

      const setMenuOpen = (open) => {
        mobileMenuPanel.hidden = !open;
        mobileMenuButton.setAttribute("aria-expanded", String(open));
        document.documentElement.classList.toggle("has-open-menu", open);

        if (open) {
          inertedElements = Array.from(document.body.children).filter(
            (element) => element !== mobileMenuPanel && !element.inert,
          );
          inertedElements.forEach((element) => {
            element.inert = true;
          });

          window.requestAnimationFrame(() => {
            (mobileMenuClose || mobileMenuFirstLink)?.focus();
          });
        } else {
          inertedElements.forEach((element) => {
            element.inert = false;
          });
          inertedElements = [];
          submenuToggles.forEach((toggle) => setSubmenuOpen(toggle, false));
        }
      };

      mobileMenuButton.addEventListener("click", () => {
        setMenuOpen(mobileMenuButton.getAttribute("aria-expanded") !== "true");
      });

      mobileMenuPanel.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setMenuOpen(false));
      });

      mobileMenuClose?.addEventListener("click", () => {
        setMenuOpen(false);
        mobileMenuButton.focus();
      });

      document.addEventListener("keydown", (event) => {
        if (mobileMenuPanel.hidden) return;

        if (event.key === "Escape") {
          setMenuOpen(false);
          mobileMenuButton.focus();
          return;
        }

        if (event.key !== "Tab") return;

        const focusableElements = Array.from(
          mobileMenuPanel.querySelectorAll(focusableSelector),
        ).filter((element) => element.offsetParent !== null);
        const firstElement = focusableElements[0];
        const lastElement = focusableElements.at(-1);
        if (!firstElement || !lastElement) return;

        if (event.shiftKey && document.activeElement === firstElement) {
          event.preventDefault();
          lastElement.focus();
        } else if (!event.shiftKey && document.activeElement === lastElement) {
          event.preventDefault();
          firstElement.focus();
        }
      });

      desktopMedia.addEventListener("change", (event) => {
        if (event.matches && !mobileMenuPanel.hidden) setMenuOpen(false);
      });
    }
  })();
</script>

<style is:global>
  /* The bar ------------------------------------------------------------- */

  /*
   * At the top of a page the bar has no fill and no rule: the block under it is
   * pulled up behind it, so the bar takes the colour of whatever opens the page
   * — a gradient band, a photograph, or the white page itself. The moment the
   * reader scrolls it becomes solid, because from then on it is sitting over
   * arbitrary content.
   */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: transparent;
    transition:
      transform 0.28s ease,
      background-color 0.28s ease,
      color 0.28s ease;
  }

  /*
   * The rule is painted inside the bar rather than as a border: a 1px border
